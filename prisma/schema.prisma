// Domínio da BOX. — ver especificação em /especificacao-experiencia-digital.html no repo da landing.
// Status e enums são strings validadas em src/lib/constants.ts (não enums nativos do Prisma)
// para manter a troca de SQLite -> Postgres no Render como uma alteração de uma linha no datasource.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("CUSTOMER") // CUSTOMER | MECHANIC | ADMIN
  phone        String?
  createdAt    DateTime @default(now())

  // Cargo (Role) — granularidade fina de permissões, além do `role` acima que
  // continua sendo usado pelas rotas legadas (requireRole). Só STAFF tem cargo.
  roleId          String?
  roleRef         Role?            @relation(fields: [roleId], references: [id])
  userPermissions UserPermission[]

  vehicles              Vehicle[]
  timelineEvents        TimelineEvent[] @relation("EventAuthor")
  vehicleParts          VehiclePart[]   @relation("PartResponsible")
  quoteRequestsAsCustomer QuoteRequest[] @relation("QuoteRequestCustomer")
  quoteRequestsAsMechanic QuoteRequest[] @relation("QuoteRequestMechanic")
  client                Client?
  appointmentsAsMechanic Appointment[]  @relation("AppointmentMechanic")
}

// Conta bancária/caixa da oficina — origem/destino de contas a pagar e a receber,
// usada para calcular saldo (initialBalance + recebido - pago) e o fluxo de caixa.
model BankAccount {
  id             String   @id @default(cuid())
  name           String
  bank           String?
  agency         String?
  accountNumber  String?
  initialBalance Float    @default(0)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  payables    AccountPayable[]
  receivables AccountReceivable[]
}

// Conta a pagar (fornecedor, boleto, despesa fixa...). Parcelas de uma mesma
// compra compartilham `groupId` e têm installmentNumber/installmentTotal preenchidos.
model AccountPayable {
  id                String       @id @default(cuid())
  description       String
  category          String
  payeeName         String
  amount            Float
  dueDate           DateTime
  paidAt            DateTime?
  paidAmount        Float?
  status            String       @default("PENDING") // PENDING | PAID | OVERDUE | CANCELLED
  paymentMethod     String?
  bankAccountId     String?
  bankAccount       BankAccount? @relation(fields: [bankAccountId], references: [id])
  // Preenchido quando esta conta foi gerada automaticamente ao enviar um pedido de compra.
  purchaseOrderId   String?
  purchaseOrder     PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  supplierId        String?
  supplier          Supplier?    @relation(fields: [supplierId], references: [id])
  installmentNumber Int?
  installmentTotal  Int?
  groupId           String?
  notes             String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
}

// Conta a receber — pode ou não estar ligada a uma OS/cliente (ex: venda de balcão avulsa).
model AccountReceivable {
  id                String        @id @default(cuid())
  description       String
  category          String
  clientId          String?
  client            Client?       @relation(fields: [clientId], references: [id])
  serviceOrderId    String?
  serviceOrder      ServiceOrder? @relation(fields: [serviceOrderId], references: [id])
  amount            Float
  dueDate           DateTime
  receivedAt        DateTime?
  receivedAmount    Float?
  status            String        @default("PENDING") // PENDING | RECEIVED | OVERDUE | CANCELLED
  paymentMethod     String?
  bankAccountId     String?
  bankAccount       BankAccount?  @relation(fields: [bankAccountId], references: [id])
  installmentNumber Int?
  installmentTotal  Int?
  groupId           String?
  notes             String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  invoices Invoice[]
}

// Nota fiscal (NF-e/NFS-e/NFC-e). `provider` identifica o gateway usado para emissão
// (MOCK em dev/sem contrato fiscal — trocar por um provider real como eNotas/Focus NFe
// implementando a mesma interface em src/services/fiscal/nfe-provider.ts).
model Invoice {
  id                  String              @id @default(cuid())
  type                String              // NFE | NFSE | NFCE
  status              String              @default("DRAFT") // DRAFT | PENDING | ISSUED | CANCELLED | ERROR
  number              String?
  series              String?
  provider            String              @default("MOCK")
  providerRef         String?
  serviceOrderId      String?
  serviceOrder        ServiceOrder?       @relation(fields: [serviceOrderId], references: [id])
  clientId            String?
  client              Client?             @relation(fields: [clientId], references: [id])
  accountReceivableId String?
  accountReceivable   AccountReceivable?  @relation(fields: [accountReceivableId], references: [id])
  totalAmount         Float
  issueDate           DateTime?
  cancelledAt         DateTime?
  xmlUrl              String?
  pdfUrl              String?
  errorMessage        String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
}

// Fornecedor — origem dos pedidos de compra e, opcionalmente, fornecedor preferencial
// de uma peça de estoque (usado para agrupar sugestões de reposição por fornecedor).
model Supplier {
  id          String   @id @default(cuid())
  name        String
  cpfCnpj     String?
  contactName String?
  phone       String?
  whatsapp    String?
  email       String?
  addressLine String?
  city        String?
  state       String?
  notes       String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  purchaseOrders   PurchaseOrder[]
  preferredForParts InventoryPart[]
  payables         AccountPayable[]
}

// Pedido de compra a um fornecedor. DRAFT -> SENT (gera automaticamente uma conta a
// pagar) -> PARTIALLY_RECEIVED/RECEIVED conforme os itens vão sendo recebidos no estoque.
model PurchaseOrder {
  id           String    @id @default(cuid())
  code         String    @unique // ex: PC-2026-00001
  supplierId   String
  supplier     Supplier  @relation(fields: [supplierId], references: [id])
  status       String    @default("DRAFT") // DRAFT | SENT | PARTIALLY_RECEIVED | RECEIVED | CANCELLED
  notes        String?
  expectedDate DateTime?
  sentAt       DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  items    PurchaseOrderItem[]
  payables AccountPayable[]
}

model PurchaseOrderItem {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  inventoryPartId String
  inventoryPart   InventoryPart @relation(fields: [inventoryPartId], references: [id])
  quantity        Int
  unitCost        Float
  receivedQty     Int           @default(0)
}

// Box/elevador físico da oficina — usado para visualizar ocupação na agenda.
model Bay {
  id        String   @id @default(cuid())
  name      String
  type      String   @default("BAY") // BAY | LIFT
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  appointments Appointment[]
}

// Compromisso na agenda visual — camada de agendamento com box/elevador e mecânico,
// desacoplada do ciclo de vida da OS (que continua tendo seu próprio `status`/`scheduledAt`).
model Appointment {
  id                   String        @id @default(cuid())
  title                String
  vehicleId            String?
  vehicle              Vehicle?      @relation(fields: [vehicleId], references: [id])
  clientId             String?
  client               Client?       @relation(fields: [clientId], references: [id])
  serviceOrderId       String?
  serviceOrder         ServiceOrder? @relation(fields: [serviceOrderId], references: [id])
  mechanicId           String?
  mechanic             User?         @relation("AppointmentMechanic", fields: [mechanicId], references: [id])
  bayId                String?
  bay                  Bay?          @relation(fields: [bayId], references: [id])
  startAt              DateTime
  estimatedDurationMin Int           @default(60)
  status               String        @default("SCHEDULED") // SCHEDULED | CONFIRMED | IN_PROGRESS | DONE | CANCELLED | NO_SHOW
  notes                String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
}

// Cargo administrável (Mecânico, Financeiro, Gerente...) — não hardcoded.
model Role {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  isSystem    Boolean  @default(false) // protege roles seed (Administrador/Mecânico) contra exclusão
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users           User[]
  rolePermissions RolePermission[]
}

// Catálogo de permissões conhecidas pelo código (resource + action).
model Permission {
  id          String   @id @default(cuid())
  resource    String
  action      String
  description String?

  rolePermissions RolePermission[]
  userPermissions UserPermission[]

  @@unique([resource, action])
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

// Exceção por funcionário: granted=true concede além do cargo, granted=false revoga.
model UserPermission {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  granted      Boolean

  @@unique([userId, permissionId])
}

// Cadastro de cliente (CRM) — entidade de negócio separada do login.
// Vinculado opcionalmente a um User (quando o cliente tem conta no portal).
model Client {
  id            String    @id @default(cuid())
  userId        String?   @unique
  user          User?     @relation(fields: [userId], references: [id])
  name          String
  cpfCnpj       String?
  rg            String?
  birthDate     DateTime?
  phone         String?
  whatsapp      String?
  email         String?
  addressLine   String?
  zipCode       String?
  city          String?
  state         String?
  company       String?
  clientType    String    @default("INDIVIDUAL") // INDIVIDUAL | COMPANY
  notes         String?
  internalNotes String?
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accountsReceivable AccountReceivable[]
  invoices           Invoice[]
  appointments       Appointment[]
}

model InventoryPart {
  id          String   @id @default(cuid())
  name        String
  sku         String?  @unique
  description String?
  unitCost    Float
  stockQty    Int      @default(0)
  // Ponto mínimo de estoque e quantidade-alvo ao repor — usados para gerar sugestões
  // automáticas de compra quando stockQty <= minStockQty.
  minStockQty Int      @default(0)
  reorderQty  Int      @default(0)
  preferredSupplierId String?
  preferredSupplier   Supplier? @relation(fields: [preferredSupplierId], references: [id])
  photoUrl    String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  usages          ProblemPartUsage[]
  financialEntries FinancialEntry[]
  purchaseOrderItems PurchaseOrderItem[]
}

model Vehicle {
  id        String   @id @default(cuid())
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id])
  brand     String
  model     String
  year      Int
  engine    String?
  plate     String?
  mileage   Int      @default(0)
  createdAt DateTime @default(now())

  serviceOrders ServiceOrder[]
  quoteRequests QuoteRequest[]
  appointments  Appointment[]
}

model ServiceOrder {
  id            String    @id @default(cuid())
  code          String    @unique // ex: OS-2026-04471
  vehicleId     String
  vehicle       Vehicle   @relation(fields: [vehicleId], references: [id])
  status        String    @default("RECEIVED")
  progress      Int       @default(0) // 0-100, calculado a partir do status + eventos
  estimatedMin  Float?
  estimatedMax  Float?
  scheduledAt   DateTime?
  receivedAt    DateTime  @default(now())
  completedAt   DateTime?
  deliveryDescription String?
  deliveryExtraValue  Float?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  timelineEvents TimelineEvent[]
  parts          VehiclePart[]
  approvals      Approval[]
  media          Media[]
  chatMessages   ChatMessage[]
  quoteRequest   QuoteRequest?
  financialEntries FinancialEntry[]
  accountsReceivable AccountReceivable[]
  invoices           Invoice[]
  appointments       Appointment[]
}

// Pedido de orçamento feito pelo cliente antes de existir uma ordem de serviço.
// Ao ser aceito pelo mecânico, dá origem a um ServiceOrder com status "SCHEDULED"
// (agendado, aguardando o cliente levar o veículo).
model QuoteRequest {
  id                 String    @id @default(cuid())
  customerId         String
  customer           User      @relation("QuoteRequestCustomer", fields: [customerId], references: [id])
  vehicleId          String
  vehicle            Vehicle   @relation(fields: [vehicleId], references: [id])
  problemDescription String
  problemKey         String?
  problemName        String?
  preferredDates     String
  status             String    @default("PENDING") // PENDING | ACCEPTED | DECLINED
  mechanicId         String?
  mechanic           User?     @relation("QuoteRequestMechanic", fields: [mechanicId], references: [id])
  scheduledAt        DateTime?
  initialValue       Float?
  declineReason      String?
  serviceOrderId     String?   @unique
  serviceOrder       ServiceOrder? @relation(fields: [serviceOrderId], references: [id])
  createdAt          DateTime  @default(now())
  respondedAt        DateTime?
}

model TimelineEvent {
  id             String       @id @default(cuid())
  serviceOrderId String
  serviceOrder   ServiceOrder @relation(fields: [serviceOrderId], references: [id])
  title          String
  description    String?
  occurredAt     DateTime     @default(now())
  done           Boolean      @default(true)
  authorId       String?
  author         User?        @relation("EventAuthor", fields: [authorId], references: [id])
  createdAt      DateTime     @default(now())

  media Media[]
}

model VehiclePart {
  id             String       @id @default(cuid())
  serviceOrderId String
  serviceOrder   ServiceOrder @relation(fields: [serviceOrderId], references: [id])
  key            String       // motor | freios | suspensao | transmissao | escapamento | eletrica | arcondicionado
  name           String
  status         String       @default("NOT_INSPECTED") // NOT_INSPECTED | IN_PROGRESS | WARNING | CRITICAL | DONE
  note           String?
  wearLevel      Int?         // 0-100
  responsibleId  String?
  responsible    User?        @relation("PartResponsible", fields: [responsibleId], references: [id])
  warranty       String?
  updatedAt      DateTime     @updatedAt
  createdAt      DateTime     @default(now())

  media     Media[]
  approvals Approval[]

  @@unique([serviceOrderId, key])
}

model Approval {
  id             String       @id @default(cuid())
  serviceOrderId String
  serviceOrder   ServiceOrder @relation(fields: [serviceOrderId], references: [id])
  // Componente ao qual este problema pertence — usado para colocar a peça em reparo
  // quando o cliente aprova, e para o mecânico marcar como resolvido depois.
  partId         String?
  part           VehiclePart? @relation(fields: [partId], references: [id])
  title          String
  description    String
  note           String?
  laborValue     Float?
  partsValue     Float?
  estimatedValue Float?
  status         String       @default("PENDING") // PENDING | APPROVED | REJECTED
  responseNote   String?
  stockAppliedAt DateTime?
  createdAt      DateTime     @default(now())
  respondedAt    DateTime?

  media      Media[]
  partUsages ProblemPartUsage[]
  financialEntries FinancialEntry[]
}

model ProblemPartUsage {
  id              String        @id @default(cuid())
  approvalId      String
  approval        Approval      @relation(fields: [approvalId], references: [id], onDelete: Cascade)
  inventoryPartId String
  inventoryPart   InventoryPart @relation(fields: [inventoryPartId], references: [id])
  quantity        Int
  unitCostSnapshot Float
  createdAt       DateTime      @default(now())

  financialEntries FinancialEntry[]
}

model FinancialEntry {
  id              String         @id @default(cuid())
  type            String         // INCOME | EXPENSE
  category        String
  description     String
  amount          Float
  serviceOrderId  String?
  serviceOrder    ServiceOrder?  @relation(fields: [serviceOrderId], references: [id])
  approvalId      String?
  approval        Approval?      @relation(fields: [approvalId], references: [id])
  inventoryPartId String?
  inventoryPart   InventoryPart? @relation(fields: [inventoryPartId], references: [id])
  partUsageId     String?
  partUsage       ProblemPartUsage? @relation(fields: [partUsageId], references: [id])
  occurredAt      DateTime       @default(now())
  createdAt       DateTime       @default(now())
}

model Media {
  id              String         @id @default(cuid())
  serviceOrderId  String
  serviceOrder    ServiceOrder   @relation(fields: [serviceOrderId], references: [id])
  timelineEventId String?
  timelineEvent   TimelineEvent? @relation(fields: [timelineEventId], references: [id])
  partId          String?
  part            VehiclePart?   @relation(fields: [partId], references: [id])
  approvalId      String?
  approval        Approval?      @relation(fields: [approvalId], references: [id])
  url             String
  type            String         // PHOTO | VIDEO | AUDIO | DOCUMENT
  label           String?
  isDeliveryPhoto Boolean        @default(false)
  createdAt       DateTime       @default(now())
}

model ChatMessage {
  id             String       @id @default(cuid())
  serviceOrderId String
  serviceOrder   ServiceOrder @relation(fields: [serviceOrderId], references: [id])
  senderRole     String       // CUSTOMER | MECHANIC
  senderName     String
  body           String?
  attachmentUrl  String?
  createdAt      DateTime     @default(now())
}
