DATABASE_URL="file:./dev.db"
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="7d"
PORT=4000
CORS_ORIGIN="http://localhost:3000"
UPLOADS_DIR="uploads"

# Cloudinary: use estes nomes no Render/produção.
# API Secret é a "passkey"/senha secreta; nunca coloque no frontend.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_FOLDER="box-diagnosticos"

# Produção (Render): trocar DATABASE_URL por uma connection string Postgres
# e mudar `provider = "sqlite"` para `provider = "postgresql"` em prisma/schema.prisma.
# DATABASE_URL="postgresql://user:password@host:5432/dbname"
