# prisma/schema.prisma usa provider = "postgresql" — precisa de um Postgres também em dev
# (local, Docker, ou um banco de dev na nuvem como Neon/Render/Supabase).
DATABASE_URL="postgresql://user:password@localhost:5432/box_dev"
# Obrigatório em produção (NODE_ENV=production) — o servidor não sobe sem ele.
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="7d"
PORT=4000
CORS_ORIGIN="http://localhost:3000"
# Endereço público do frontend — usado no link de "Esqueci minha senha" (cai no CORS_ORIGIN se vazio).
FRONTEND_URL="http://localhost:3000"

# E-mail para "Esqueci minha senha". Configure UM dos três (ordem de preferência):
# 1. RESEND_API_KEY (resend.com) ou 2. BREVO_API_KEY (brevo.com) — enviam por HTTPS e
#    funcionam no Render (o plano gratuito do Render BLOQUEIA as portas de SMTP);
# 3. SMTP_* — Gmail: smtp.gmail.com, porta 587, SMTP_USER = seu e-mail e SMTP_PASS = uma
#    "senha de app". Porta 465 => SMTP_SECURE="true".
# Sem nenhum, o e-mail não é enviado: o link aparece só no log do servidor.
# MAIL_FROM: remetente. No Resend, o domínio precisa estar verificado (para testar,
# "Reblind <onboarding@resend.dev>" só entrega para o e-mail dono da conta Resend).
# No Brevo, o remetente precisa estar cadastrado/validado em "Senders".
MAIL_FROM="Reblind <no-reply@seudominio.com.br>"
RESEND_API_KEY=""
BREVO_API_KEY=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Reblind <no-reply@seudominio.com.br>"

# Rotina de hora em hora (alertas + contas vencidas). "true" desliga, ex.: em scripts/testes.
DISABLE_SCHEDULER="false"
UPLOADS_DIR="uploads"

# Cloudinary: use estes nomes no Render/produção.
# API Secret é a "passkey"/senha secreta; nunca coloque no frontend.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_FOLDER="box-diagnosticos"

# Leitura de imagem por IA via OpenAI Vision — usada em dois pontos: nota fiscal
# (Financeiro > Notas fiscais) e reconhecimento de veículo (Novo projeto > tirar foto).
# Sem essa chave, os dois botões de leitura automática só avisam que não está configurado.
# A mesma chave também alimenta o assistente de texto da busca global (sem imagem).
OPENAI_API_KEY=""
OPENAI_VISION_MODEL="gpt-4o-mini"
OPENAI_TEXT_MODEL="gpt-4o-mini"
