# prisma/schema.prisma usa provider = "postgresql" — precisa de um Postgres também em dev
# (local, Docker, ou um banco de dev na nuvem como Neon/Render/Supabase).
DATABASE_URL="postgresql://user:password@localhost:5432/box_dev"
# Obrigatório em produção (NODE_ENV=production) — o servidor não sobe sem ele.
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="7d"
PORT=4000
CORS_ORIGIN="http://localhost:3000"
# Endereço público do frontend — usado no link de "Esqueci minha senha" (cai no CORS_ORIGIN se vazio).
FRONTEND_URL="http://localhost:3000"

# E-mail (SMTP) para "Esqueci minha senha". Sem SMTP_HOST o e-mail não é enviado: o link
# aparece só no log do servidor. Gmail: smtp.gmail.com, porta 587, SMTP_USER = seu e-mail e
# SMTP_PASS = uma "senha de app" (não a senha normal da conta). Porta 465 => SMTP_SECURE="true".
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Reblind <no-reply@seudominio.com.br>"

# Rotina de hora em hora (alertas + contas vencidas). "true" desliga, ex.: em scripts/testes.
DISABLE_SCHEDULER="false"
UPLOADS_DIR="uploads"

# Cloudinary: use estes nomes no Render/produção.
# API Secret é a "passkey"/senha secreta; nunca coloque no frontend.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_FOLDER="box-diagnosticos"

# Leitura de imagem por IA via OpenAI Vision — usada em dois pontos: nota fiscal
# (Financeiro > Notas fiscais) e reconhecimento de veículo (Novo projeto > tirar foto).
# Sem essa chave, os dois botões de leitura automática só avisam que não está configurado.
# A mesma chave também alimenta o assistente de texto da busca global (sem imagem).
OPENAI_API_KEY=""
OPENAI_VISION_MODEL="gpt-4o-mini"
OPENAI_TEXT_MODEL="gpt-4o-mini"
