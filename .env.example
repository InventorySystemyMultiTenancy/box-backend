# prisma/schema.prisma usa provider = "postgresql" — precisa de um Postgres também em dev
# (local, Docker, ou um banco de dev na nuvem como Neon/Render/Supabase).
DATABASE_URL="postgresql://user:password@localhost:5432/box_dev"
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="7d"
PORT=4000
CORS_ORIGIN="http://localhost:3000"
UPLOADS_DIR="uploads"

# Cloudinary: use estes nomes no Render/produção.
# API Secret é a "passkey"/senha secreta; nunca coloque no frontend.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_FOLDER="box-diagnosticos"

# Leitura de imagem por IA via OpenAI Vision — usada em dois pontos: nota fiscal
# (Financeiro > Notas fiscais) e reconhecimento de veículo (Novo projeto > tirar foto).
# Sem essa chave, os dois botões de leitura automática só avisam que não está configurado.
OPENAI_API_KEY=""
OPENAI_VISION_MODEL="gpt-4o-mini"
